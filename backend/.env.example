# Database: PostgreSQL URL (or sqlite:///./api_security.db for local dev)
DATABASE_URL=sqlite:///./api_security.db

# JWT & Security
JWT_SECRET=super-secret-production-grade-random-key-change-me-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (OpenAI Compatible)
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# CORS & Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Anomaly & Risk Thresholds
RISK_THRESHOLD_MEDIUM=0.40
RISK_THRESHOLD_HIGH=0.70
RISK_THRESHOLD_CRITICAL=0.88
