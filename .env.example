# ==============================================================================
# API SECURITY USING AI/ML - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="Real-World Indian E-Commerce + API Security AI/ML"
VERSION=1.0.0
API_V1_PREFIX=/api

# Database Connection (SQLite default for local, PostgreSQL for production)
# SQLite Local:
DATABASE_URL=sqlite:///./api_security.db
# PostgreSQL Container / Production:
# DATABASE_URL=postgresql://apisec_user:apisec_secure_password_123@localhost:5432/apisecurity_db

# JWT & Authentication Security
JWT_SECRET=super-secret-production-grade-random-key-change-me-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Whitelist (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# E-Commerce & Indian Payment Settings
CURRENCY=INR
UPI_ID=aadityabhardwaj5398@oksbi
PAYMENT_MODE=demo  # 'demo' for ₹0 risk-free demonstration, 'sandbox' for gateway testing

# Explainable AI & LLM Incident Synthesizer (Optional - Falls back to deterministic rule engine if empty)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# AI/ML & GNN Anomaly Detection Thresholds
ISOLATION_FOREST_CONTAMINATION=0.08
SLIDING_WINDOW_MINUTES=1.0
RISK_THRESHOLD_HIGH=75
RISK_THRESHOLD_MEDIUM=45
